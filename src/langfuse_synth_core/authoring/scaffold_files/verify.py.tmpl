"""`synth verify` — read the data back through the library and assert it landed.

The read seam (`langfuse_synth_core.read`) is the read-client: it owns the Langfuse API
endpoints, follows their pagination to the end, and normalises what comes back. What stays
HERE is the scenario talking — which assertions to make about what landed. The walking
skeleton asserts the floor: traces are visible and the `quality` score family is present.
Grow the checks as the story grows.

**The seam reads whichever generation the target serves.** Langfuse platform v4 makes the
observation the primary entity — there is no separately ingested trace, so a trace *is* its
observations — and the older trace / observation / session / score list endpoints are
removed when Cloud goes v4-only on 2026-11-16. The seam probes the target once, picks the
arm, and hands back the same rows either way, so nothing below has to know which answered.
`TargetProfile.resolved()` is what asks; its `label` says so in the log, which is the first
thing to know when a check that passed yesterday fails today.

Add scenario reads as calls on the `reader` — `reader.trace(id)`, `reader.observations(…)`,
`reader.scores(name=…)`, `reader.experiments(…)` — rather than reaching for an HTTP client
of your own: that is what keeps this kit off the endpoints and out of the next migration.
The handful of endpoints the seam does not model (datasets, dataset-items, score-configs,
prompts, annotation queues) are read with `lfread.get_json`, which carries the same auth and
the same Retry-After-aware backoff.
"""
from __future__ import annotations

from dataclasses import dataclass, field

from langfuse_synth_core.target import TargetProfile

from .config import Config


@dataclass
class Check:
    name: str
    ok: bool
    detail: str


@dataclass
class VerifyReport:
    checks: list[Check] = field(default_factory=list)

    def add(self, name: str, ok: bool, detail: str) -> None:
        self.checks.append(Check(name, ok, detail))

    @property
    def ok(self) -> bool:
        return all(c.ok for c in self.checks)


def run_verify(cfg: Config, *, log=print) -> VerifyReport:
    """Query the target project back and report each floor check pass/fail."""
    profile = TargetProfile.detect(cfg.target.base_url).resolved()
    reader = profile.reader()
    log(f"· verifying against {profile.label} ({profile.base_url})")
    report = VerifyReport()

    # A sample of traces, never a project total — under v4 there is no trace list to count.
    traces = reader.traces(limit=5)
    report.add("traces_present", bool(traces), f"{len(traces)} trace(s) read back")

    scores = reader.scores(name="quality", limit_pages=1)
    report.add("quality_scores_present", bool(scores), f"{len(scores)} quality score(s) read back")

    for check in report.checks:
        log(f"{'✓' if check.ok else '✗'} {check.name}: {check.detail}")
    return report
