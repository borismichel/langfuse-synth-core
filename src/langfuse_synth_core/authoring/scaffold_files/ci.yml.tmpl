# Runs this kit's pytest suite on every push / PR, so the determinism golden and the
# manifest-validate gate fail loudly in CI and not just on the author's laptop.
#
# The job is named `test` on purpose: that is the status-check name the kit repos'
# `protect main` ruleset requires, so branch protection is applicable from the first push.
#
# GitHub-hosted runner: kit repos are PUBLIC, so hosted minutes are free and the
# infrastructure policy requires GitHub-hosted CI/CD on public repos (no self-hosted
# runners). The suite is network-free — the determinism golden runs its seed in a
# subprocess under the deny-LLM egress block — so no project secret is needed here.

name: CI

on:
  push:
    branches: ["**"]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"  # matches the runtime image (Dockerfile: python:3.12-slim)
      - name: Install (runtime + dev, from the pinned core)
        run: pip install -e '.[dev]'
      - name: Test (determinism golden + manifest validate + unit suite)
        run: pytest -q
      # The Contract as executable checks (portal #198). Enforcing, not --advisory: a
      # scaffolded kit is born in the target shape, so a violation here is a regression,
      # never migration debt.
      - name: Contract conformance (synth-authoring conformance)
        run: synth-authoring conformance .
